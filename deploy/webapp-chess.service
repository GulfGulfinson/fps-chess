# /etc/systemd/system/webapp-chess.service on gulfinson
# FPS Chess match server, reached through nginx as wss://chess.gulfgulfinson.de.
[Unit]
Description=FPS Chess match server (chess.gulfgulfinson.de)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pschneid
Group=pschneid
WorkingDirectory=/home/pschneid/websites/chess.gulfgulfinson.de/current
EnvironmentFile=/home/pschneid/websites/chess.gulfgulfinson.de/shared/.env
ExecStart=/home/pschneid/.local/opt/Godot_v4.7.2-stable_mono_linux_x86_64/Godot_v4.7.2-stable_mono_linux.x86_64 --headless --path /home/pschneid/websites/chess.gulfgulfinson.de/current/game -- --server --port 3107 --bind 127.0.0.1
Restart=always
RestartSec=5s
StandardOutput=append:/home/pschneid/websites/chess.gulfgulfinson.de/shared/logs/webapp-chess.log
StandardError=append:/home/pschneid/websites/chess.gulfgulfinson.de/shared/logs/webapp-chess.err.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Godot writes its user:// data and logs below XDG_DATA_HOME, which shared/.env points into shared/data.
ReadWritePaths=/home/pschneid/websites/chess.gulfgulfinson.de/shared/logs /home/pschneid/websites/chess.gulfgulfinson.de/shared/data

[Install]
WantedBy=multi-user.target
